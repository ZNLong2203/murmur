# ─────────────────────────────────────────────────────────────
#  Private — never pushed. The repo goes public; these do not.
# ─────────────────────────────────────────────────────────────
/private/
*.private.md

# ─── Secrets ─────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── OS / editor ─────────────────────────────────────────────
.DS_Store
.idea/

# ─── Build / dependencies ────────────────────────────────────
/node_modules
/.pnp
.pnp.*
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
/coverage
.vercel
npm-debug.log*

# ─── Fetched at install/build, never committed ───────────────
# BirdNET model and labels (CC BY-SA 4.0, downloaded from Zenodo by
# scripts/fetch-models.mjs), the onnxruntime-web WASM binaries and
# MapLibre's worker bundle.
/public/models/
/public/ort/
/public/maplibre/

# ─── Local data ──────────────────────────────────────────────
# PGlite database used when DATABASE_URL is unset.
/.data/

# ─── Offline pipeline (Python) ───────────────────────────────
/pipeline/.venv/
/pipeline/.cache/
__pycache__/
*.f32

# ─── Local agent tooling (installed by CLIs, not part of the app) ───
/.agents/
/.claude/skills/
/skills-lock.json
