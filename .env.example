# Postgres for the shared commons (e.g. a Neon connection string).
# Leave empty to use an in-process PGlite database under .data/.
DATABASE_URL=

# Code that unlocks expert votes on /verify. Leave empty to disable experts.
MURMUR_EXPERT_CODE=

# Public URL of the deployment; also the root of Murmur's FHIR canonicals.
NEXT_PUBLIC_SITE_URL=

# Optional: a local folder holding the upstream model files, to skip downloads.
MURMUR_MODEL_SRC_DIR=
